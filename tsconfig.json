{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/data/**/*.ts",
    "src/three/**/*.ts",
    "src/audio/**/*.ts",
    "src/host/**/*.ts",
    "scripts/**/*.ts"
  ]
}
