# Copia in .env.local per sovrascrivere i valori di default (NON committare .env.local).
#
# Signaling server PeerJS. Di default si usa il cloud pubblico gratuito di PeerJS (0.peerjs.com),
# quindi nessun backend nostro. Impostali solo se vuoi usare un PeerServer self-hosted.
# VITE_PEER_HOST=localhost
# VITE_PEER_PORT=9000
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=false
#
# TURN opzionale (consigliato per reti 4G/5G con NAT simmetrico). Lo STUN è già incluso.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=pass
